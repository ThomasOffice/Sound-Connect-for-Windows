<Window
    x:Class="Xm6Control.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNav" Content="概览" Tag="overview" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="环境声音控制" Tag="noise" Icon="Audio" />
                <NavigationViewItem Content="均衡器" Tag="eq" Icon="Audio" />
                <NavigationViewItem Content="聆听模式" Tag="listening" Icon="Audio" />
                <NavigationViewItem Content="多点连接" Tag="multipoint" />
                <NavigationViewItem Content="自动关机" Tag="autopower" />
                <NavigationViewItem Content="关闭行为" Tag="closebehavior" Icon="Setting" />
                <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Top">
                <StackPanel x:Name="ContentPanel" Padding="28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                    <StackPanel x:Name="OverviewSection" Spacing="16">
                        <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Sony WH-1000XM6 的本机控制面板" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <Grid ColumnSpacing="24" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="设备" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceNameText" Text="WH-1000XM6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="固件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FirmwareText" Text="未读取" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="电量" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BatteryText" Text="未读取" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ConnectionText" Text="未连接" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RefreshButton" Content="刷新状态" Click="Refresh_Click" />
                            <TextBlock x:Name="LastUpdatedText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="NoiseSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="环境声音控制" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="当前状态会先读取，再写入，并回读确认。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="NoiseCurrentText" Text="当前模式：未读取" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <RadioButtons x:Name="NoiseModeRadio" Header="模式"
                                              SelectionChanged="NoiseModeRadio_SelectionChanged">
                                    <RadioButton Content="降噪" Tag="nc" />
                                    <RadioButton Content="环境声" Tag="asm" />
                                    <RadioButton Content="关闭" Tag="off" />
                                </RadioButtons>

                                <StackPanel x:Name="AmbientControls" Spacing="12">
                                    <Slider x:Name="AmbientLevelSlider" Header="环境声等级"
                                            ValueChanged="AmbientLevelSlider_ValueChanged" />
                                    <TextBlock x:Name="AmbientLevelText" Text="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <ToggleSwitch x:Name="NoiseAdaptiveToggle" Header="自动环境声音"
                                                  OnContent="开启" OffContent="关闭"
                                                  Toggled="NoiseAdaptiveToggle_Toggled" />
                                    <ComboBox x:Name="NoiseAdaptiveSensitivityCombo" Header="灵敏度"
                                              Width="220" DisplayMemberPath="Label" />

                                    <ToggleSwitch x:Name="VoiceFocusToggle" Header="关注语音"
                                                  OnContent="开启" OffContent="关闭" />
                                </StackPanel>

                                <Button x:Name="ApplyNoiseButton" Content="应用并回读" Click="ApplyNoise_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="EqSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="均衡器" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="当前预设和 10 段频段值来自耳机；写入后会重新读取确认。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="EqCurrentText" Text="当前 EQ：未读取" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="EqPresetCombo" Header="预设" Width="260"
                                          SelectionChanged="EqPresetCombo_SelectionChanged" />

                                <StackPanel x:Name="EqBandsPanel" Spacing="4" />
                                <Button x:Name="ApplyEqButton" Content="应用并回读" Click="ApplyEq_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ListeningSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="聆听模式" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="标准模式使用当前 EQ；背景音乐和电影会启用耳机音效。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="ListeningCurrentText" Text="当前模式：未读取"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ListeningEqText" Text="当前 EQ：未读取"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <RadioButtons x:Name="ListeningModeRadio" Header="模式"
                                              SelectionChanged="ListeningModeRadio_SelectionChanged">
                                    <RadioButton Content="标准（使用 EQ）" Tag="standard" />
                                    <RadioButton Content="背景音乐" Tag="bgm" />
                                    <RadioButton Content="电影" Tag="cinema" />
                                </RadioButtons>

                                <ComboBox x:Name="BgmRoomCombo" Header="背景音乐距离"
                                          Width="260" DisplayMemberPath="Label" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ApplyListeningButton" Content="应用并回读"
                                            Click="ApplyListening_Click" />
                                    <Button Content="刷新状态" Click="Refresh_Click" />
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="说明：背景音乐的距离对应我的房间、客厅、咖啡馆。切换到标准会关闭 BGM / 电影音效，并恢复当前 EQ 设置。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MultipointSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="多点连接" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="允许耳机同时连接两台设备；关闭后第二台设备会断开。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="MultipointStateText" Text="当前状态：未读取"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ToggleSwitch x:Name="MultipointToggle" Header="多点连接"
                                              OnContent="开启" OffContent="关闭" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ApplyMultipointButton" Content="应用并回读"
                                            Click="ApplyMultipoint_Click" />
                                    <Button Content="刷新状态" Click="Refresh_Click" />
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="说明：耳机端没有公开设备列表/主动切换命令。此处控制多点连接开关；在手机与电脑之间切换音频源由耳机和当前播放设备自动完成。若耳机正在使用 LDAC，关闭多点连接可能被拒绝。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AutoPowerSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="自动关机" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="设置取下耳机后自动关机，或关闭自动关机。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="AutoPowerStateText" Text="当前状态：未读取"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ComboBox x:Name="AutoPowerCombo" Header="自动关机"
                                          Width="260" DisplayMemberPath="Label" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ApplyAutoPowerButton" Content="应用并回读"
                                            Click="ApplyAutoPower_Click" />
                                    <Button Content="刷新状态" Click="Refresh_Click" />
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="说明：自动关机只有“取下耳机后”和“关闭”两种状态。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CloseBehaviorSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="关闭行为" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="选择点击窗口关闭按钮时的行为。" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <RadioButtons x:Name="CloseBehaviorRadio"
                                              SelectionChanged="CloseBehaviorRadio_SelectionChanged">
                                    <RadioButton Content="直接关闭应用" Tag="close" />
                                    <RadioButton Content="隐藏到系统托盘" Tag="tray" />
                                </RadioButtons>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="隐藏后，可从系统托盘菜单打开“概览”或“聆听模式”，也可以从托盘退出应用。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="XM6 Control" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="版本 1.0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="本机 Sony WH-1000XM6 控制工具，支持环境声音控制（降噪/环境声/关闭、自动环境声音、关注语音）、均衡器、聆听模式、多点连接、自动关机和系统托盘。" />
                                <TextBlock Text="LE Tandem 控制通道；不使用云服务，不上传设备数据。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="功能和源码：" />
                                <HyperlinkButton Content="GitHub - ThomasOffice/Sound-Connect-for-Windows"
                                                 NavigateUri="https://github.com/ThomasOffice/Sound-Connect-for-Windows" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>










