<Window
    x:Class="Xm6Control.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Xm6Control.App"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="NavigationIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            </Style>
            <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem loc:Loc.Content="nav.overview" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.noise" Tag="noise">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.eq" Tag="eq">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.listening" Tag="listening">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE7F6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.multipoint" Tag="multipoint">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE975;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.autopower" Tag="autopower">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.scenes" Tag="scenes">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE728;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.about" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavigationIconStyle}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Top">
                <StackPanel Padding="28" Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LastUpdatedText" Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                loc:Loc.Content="overview.refresh" Click="Refresh_Click" />
                    </Grid>

                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                    <StackPanel x:Name="OverviewSection" Spacing="16">
                        <TextBlock loc:Loc.Text="page.overview.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.overview.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="24" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" loc:Loc.Text="overview.device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceNameText" Text="WH-1000XM6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" loc:Loc.Text="overview.firmware" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FirmwareText" loc:Loc.Text="overview.unknown" />

                                <TextBlock Grid.Row="2" Grid.Column="0" loc:Loc.Text="overview.battery" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BatteryText" loc:Loc.Text="overview.unknown" />

                                <TextBlock Grid.Row="3" Grid.Column="0" loc:Loc.Text="overview.connection" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ConnectionText" loc:Loc.Text="overview.disconnected" />

                                <TextBlock Grid.Row="4" Grid.Column="0" loc:Loc.Text="overview.codec" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CodecText" loc:Loc.Text="overview.unknown" />

                                <TextBlock Grid.Row="5" Grid.Column="0" loc:Loc.Text="overview.dsee" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DseeOverviewText" loc:Loc.Text="overview.unknown" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="NoiseSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.noise.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.noise.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="NoiseCurrentText" loc:Loc.Text="common.current.mode" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <RadioButtons x:Name="NoiseModeRadio" loc:Loc.Header="common.mode"
                                              SelectionChanged="NoiseModeRadio_SelectionChanged">
                                    <RadioButton loc:Loc.Content="noise.mode.nc" Tag="nc" />
                                    <RadioButton loc:Loc.Content="noise.mode.asm" Tag="asm" />
                                    <RadioButton loc:Loc.Content="noise.mode.off" Tag="off" />
                                </RadioButtons>

                                <StackPanel x:Name="AmbientControls" Spacing="12">
                                    <Slider x:Name="AmbientLevelSlider" loc:Loc.Header="noise.level"
                                            ValueChanged="AmbientLevelSlider_ValueChanged" />
                                    <TextBlock x:Name="AmbientLevelText" Text="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <ToggleSwitch x:Name="NoiseAdaptiveToggle" loc:Loc.Header="noise.adaptive"
                                                  loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                                  Toggled="NoiseAdaptiveToggle_Toggled" />
                                    <ComboBox x:Name="NoiseAdaptiveSensitivityCombo" loc:Loc.Header="noise.sensitivity"
                                              Width="220" DisplayMemberPath="Label" />

                                    <ToggleSwitch x:Name="VoiceFocusToggle" loc:Loc.Header="noise.voicefocus"
                                                  loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off" />
                                </StackPanel>

                                <Button x:Name="ApplyNoiseButton" loc:Loc.Content="button.apply.verify" Click="ApplyNoise_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="EqSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.eq.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.eq.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="EqCurrentText" loc:Loc.Text="common.current.eq" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="EqPresetCombo" loc:Loc.Header="eq.preset" Width="260"
                                          SelectionChanged="EqPresetCombo_SelectionChanged" />

                                <StackPanel x:Name="EqBandsPanel" Spacing="4" />
                                <Button x:Name="ApplyEqButton" loc:Loc.Content="button.apply.verify" Click="ApplyEq_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ListeningSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.listening.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.listening.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="ListeningCurrentText" loc:Loc.Text="common.current.mode"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ListeningEqText" loc:Loc.Text="common.current.eq"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <RadioButtons x:Name="ListeningModeRadio" loc:Loc.Header="common.mode"
                                              SelectionChanged="ListeningModeRadio_SelectionChanged">
                                    <RadioButton loc:Loc.Content="listening.mode.standard" Tag="standard" />
                                    <RadioButton loc:Loc.Content="listening.mode.bgm" Tag="bgm" />
                                    <RadioButton loc:Loc.Content="listening.mode.cinema" Tag="cinema" />
                                </RadioButtons>

                                <ComboBox x:Name="BgmRoomCombo" loc:Loc.Header="listening.room"
                                          Width="260" DisplayMemberPath="Label" />

                                <Button x:Name="ApplyListeningButton" loc:Loc.Content="button.apply.verify"
                                        Click="ApplyListening_Click" />

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="listening.hint" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DseeBox" Visibility="Collapsed"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock loc:Loc.Text="dsee.title" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ToggleSwitch x:Name="DseeToggle" loc:Loc.Header="dsee.auto"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="DseeToggle_Toggled" />

                                <TextBlock x:Name="DseeStatusText" TextWrapping="Wrap" />

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="dsee.hint" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MultipointSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.multipoint.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.multipoint.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="MultipointStateText" loc:Loc.Text="common.current.state"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ToggleSwitch x:Name="MultipointToggle" loc:Loc.Header="multipoint.label"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off" />

                                <Button x:Name="ApplyMultipointButton" loc:Loc.Content="button.apply.verify"
                                        Click="ApplyMultipoint_Click" />

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="multipoint.hint" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AutoPowerSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.autopower.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.autopower.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="AutoPowerStateText" loc:Loc.Text="common.current.state"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ComboBox x:Name="AutoPowerCombo" loc:Loc.Header="autopower.label"
                                          Width="260" DisplayMemberPath="Label" />

                                <Button x:Name="ApplyAutoPowerButton" loc:Loc.Content="button.apply.verify"
                                        Click="ApplyAutoPower_Click" />

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="autopower.hint" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ScenesSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.scenes.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.scenes.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock loc:Loc.Text="scenes.new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="SceneNameBox" loc:Loc.Header="scenes.name" Width="360"
                                         loc:Loc.Placeholder="scenes.name.placeholder" />
                                <Button loc:Loc.Content="scenes.capture"
                                        Click="CaptureScene_Click" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="scenes.capture.hint" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock loc:Loc.Text="scenes.saved" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="NoScenesText" loc:Loc.Text="scenes.empty"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="SceneListPanel" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.settings.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Text="page.settings.subtitle"
                                   Style="{StaticResource PageSubtitleTextBlockStyle}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.startup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="LaunchOnStartupToggle" loc:Loc.Header="settings.launch"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <ToggleSwitch x:Name="StartMinimizedToggle" loc:Loc.Header="settings.startminimized"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <ToggleSwitch x:Name="RefreshOnStartToggle" loc:Loc.Header="settings.refreshonstart"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="settings.startup.hint" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.window" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="RememberWindowToggle" loc:Loc.Header="settings.rememberwindow"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <TextBlock x:Name="LastSectionText" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button loc:Loc.Content="settings.resetwindow"
                                        Click="ResetWindow_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="ThemeCombo" loc:Loc.Header="settings.theme" Width="260"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SettingsSelection_Changed" />
                                <ComboBox x:Name="BackdropCombo" loc:Loc.Header="settings.backdrop" Width="260"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SettingsSelection_Changed" />
                                <ComboBox x:Name="LanguageCombo" loc:Loc.Header="settings.language" Width="260"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SettingsSelection_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.tray" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="TrayShowStatusToggle" loc:Loc.Header="settings.tray.showstatus"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <ComboBox x:Name="TrayClickCombo" loc:Loc.Header="settings.tray.click" Width="260"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SettingsSelection_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.refresh" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="AutoRefreshCombo" loc:Loc.Header="settings.autorefresh" Width="260"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SettingsSelection_Changed" />
                                <ToggleSwitch x:Name="AutoReconnectToggle" loc:Loc.Header="settings.autoreconnect"
                                              loc:Loc.OnContent="toggle.on" loc:Loc.OffContent="toggle.off"
                                              Toggled="SettingsToggle_Changed" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="settings.refresh.hint" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="DeviceNameBox" loc:Loc.Header="settings.device.name" Width="360"
                                         LostFocus="SettingsText_LostFocus" />
                                <TextBox x:Name="DeviceAddressBox" loc:Loc.Header="settings.device.address" Width="360"
                                         PlaceholderText="AA:BB:CC:DD:EE:FF"
                                         LostFocus="SettingsText_LostFocus" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="settings.device.hint" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock loc:Loc.Text="settings.close" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <RadioButtons x:Name="CloseBehaviorRadio"
                                              SelectionChanged="SettingsSelection_Changed">
                                    <RadioButton loc:Loc.Content="settings.close.direct" Tag="close" />
                                    <RadioButton loc:Loc.Content="settings.close.tray" Tag="tray" />
                                </RadioButtons>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           loc:Loc.Text="settings.close.hint" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="page.about.title" Style="{StaticResource TitleTextBlockStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock loc:Loc.Text="about.name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock loc:Loc.Text="about.version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextWrapping="Wrap"
                                           loc:Loc.Text="about.body" />
                                <TextBlock loc:Loc.Text="about.local" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock loc:Loc.Text="about.links" />
                                <HyperlinkButton Content="GitHub - ThomasOffice/Sound-Connect-for-Windows"
                                                 NavigateUri="https://github.com/ThomasOffice/Sound-Connect-for-Windows" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>










