<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Xm6Control.Bluetooth.Windows\Xm6Control.Bluetooth.Windows.csproj" />
    <ProjectReference Include="..\Xm6Control.Core\Xm6Control.Core.csproj" />
    <ProjectReference Include="..\Xm6Control.Protocol\Xm6Control.Protocol.csproj" />
    <ProjectReference Include="..\Xm6Control.Xm6\Xm6Control.Xm6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>

  <!--
    The self-contained Windows App SDK payload includes AI/ML and widget
    components this app never loads (verified against the running process's
    module list). WinUIEdit.dll is required for text input and is kept.
  -->
  <Target Name="TrimUnusedWindowsAppSdkPayload" AfterTargets="Publish">
    <ItemGroup>
      <_UnusedPayload Include="$(PublishDir)onnxruntime*.dll" />
      <_UnusedPayload Include="$(PublishDir)DirectML.dll" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.Windows.AI.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.Windows.Widgets*" />
      <_UnusedPayload Include="$(PublishDir)NpuDetect\**\*" />
    </ItemGroup>

    <ItemGroup>
      <_PublishedDirectory Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_UnusedLocaleDirectory
        Include="@(_PublishedDirectory)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^[a-z]{2,3}(-[A-Za-z]{2,4})+$')) AND '%(Filename)' != 'en-us' AND '%(Filename)' != 'zh-CN' AND '%(Filename)' != 'zh-TW'" />
    </ItemGroup>

    <Delete Files="@(_UnusedPayload)" ContinueOnError="true" />
    <RemoveDir Directories="@(_UnusedLocaleDirectory)" ContinueOnError="true" />
    <RemoveDir Directories="$(PublishDir)NpuDetect" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <None Update="Assets\app.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>Xm6Control.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>Sound Connect for Windows</Product>
    <AssemblyTitle>Sound Connect for Windows</AssemblyTitle>
  </PropertyGroup>

</Project>


